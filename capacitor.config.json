{
  "appId": "com.darkengine.app",
  "appName": "DarkEngine",
  "webDir": "www",
  "backgroundColor": "#07080b",
  "android": { "backgroundColor": "#07080b" },
  "plugins": {
    "CapacitorHttp": { "enabled": true },
    "LocalNotifications": { "smallIcon": "ic_stat_de", "iconColor": "#FF6A1A" },
    "BackgroundRunner": {
      "label": "com.darkengine.app.check",
      "src": "runners/background.js",
      "event": "checkTrades",
      "repeat": true,
      "interval": 15,
      "autoStart": true
    }
  }
}
